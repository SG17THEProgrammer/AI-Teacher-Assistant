# --- AI / OCR provider -------------------------------------------------
# Required. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model used for vision extraction (handwriting, layout, bounding boxes).
# gemini-2.5-flash is the default: fast + cheap + strong handwriting OCR.
# Swap to gemini-2.5-pro for harder scans if accuracy matters more than cost.
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to force the Tesseract.js fallback pipeline even when
# GEMINI_API_KEY is present (useful for local dev without API costs).
FORCE_OCR_FALLBACK=false

# --- App behaviour -------------------------------------------------------
# Max upload size per file, in MB (matches the 10MB shown in the design).
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Confidence threshold below which a mapping is flagged for teacher review.
MAPPING_CONFIDENCE_THRESHOLD=0.55

# Session TTL in minutes for in-memory storage (no DB is used by design).
SESSION_TTL_MINUTES=120
